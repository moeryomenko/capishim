[Unit]
Requires=capishim-setup.service
After=capishim-setup.service

[Container]
Pod=capishim.pod
Image={{ .Image }}
Volume={{ .StateDir }}/pki:{{ .StateDir }}/pki:ro
Volume={{ .StateDir }}/kubeconfigs:{{ .StateDir }}/kubeconfigs:ro
Volume={{ .StateDir }}/pki/core-webhook:{{ .StateDir }}/pki/core-webhook:ro
Exec={{ .Exec }}
User=0